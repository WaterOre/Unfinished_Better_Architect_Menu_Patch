<?xml version="1.0" encoding="utf-8" ?>

<Patch>

	<!-- wasn't fully sure where to put this but The Lore™️ says it's growing microorganisms -->

	<Operation Class="PatchOperationReplace">
        <success>Always</success>
        <xpath>Defs/ThingDef[defName="AV_Mechtech.CultivationPod"]</xpath>
        <value>
            <designationCategory>Ferny_Farming</designationCategory>
        </value>
    </Operation>
	
	<Operation Class="PatchOperationReplace">
        <success>Always</success>
        <xpath>Defs/ThingDef[defName="AV_ProductionMonitor"]</xpath>
        <value>
            <designationCategory>Ferny_ProductionInfrastructure</designationCategory>
        </value>
    </Operation>
	
	<Operation Class="PatchOperationReplace">
        <success>Always</success>
        <xpath>Defs/ThingDef[defName="AV_NeutroamineFreezer"]</xpath>
        <value>
            <designationCategory>Ferny_Cooling</designationCategory>
        </value>
    </Operation>
	
	<Operation Class="PatchOperationReplace">
        <success>Always</success>
        <xpath>Defs/ThingDef[defName="AV_CoolingCell"]</xpath>
        <value>
            <designationCategory>Ferny_Cooling</designationCategory>
        </value>
    </Operation>

</Patch>