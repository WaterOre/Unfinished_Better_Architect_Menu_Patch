<?xml version="1.0" encoding="utf-8" ?>

<Patch>

<!-- the valerie furniture would be well-suited to a style and prop conversion treatment -->

	<Operation Class="PatchOperationAddModExtension">
		<success>Always</success>
		<xpath>Defs/DesignationCategoryDef[defName="Milira_Building_Test"]</xpath>
		<value>
			<li Class="BetterArchitect.NestedCategoryExtension">
				<parentCategory>Ferny_Aliens</parentCategory>
			</li>
		</value>
	</Operation>
	
<!-- thank you @bblkepling for the xml formatting help! -->
	
	<Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName[contains(text(), "Milira_"]]</xpath>
        <value>
            <designationCategory>Ferny_Milira</designationCategory>
        </value>
    </Operation>

</Patch>